local function switchTab(name)
    currentTab = name
    for n, p in pairs(pages) do p.Visible = (n == name) end
    for n, b in pairs(tabBtns) do
        b.BackgroundColor3 = (n == name) and Theme.accent or Color3.fromRGB(30, 24, 48)
        b.TextColor3 = (n == name) and Color3.new(1,1,1) or Theme.muted
    end
end

