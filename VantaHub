UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.RightControl then
        setOpen(not open)
    end
end)

local function applyHitbox()
    if not C.HitboxExpander then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if C.TeamCheck and plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then continue end
        local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            pcall(function()
                hrp.Size = Vector3.new(C.HitboxSize, C.HitboxSize, C.HitboxSize)
                hrp.Transparency = 0.7
                hrp.CanCollide = false
            end)
        end
    end
end

RunService.RenderStepped:Connect(function()
    local FOVCircle = getgenv().VantaFOV
    if FOVCircle then
        FOVCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
        FOVCircle.Radius = C.FOV
        FOVCircle.Visible = C.ShowFOV
    end
    getgenv().VantaUpdateESP()
    if C.HitboxExpander then applyHitbox() end

    local t = getgenv().VantaPickTarget()
    getgenv().VantaLocked = t
    if t then
        if C.Aimlock or C.Camlock or holding then
            getgenv().VantaAimAt(t, true)
        elseif C.Aimbot and (holding or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)) then
            getgenv().VantaAimAt(t, false)
        elseif C.AimAssist or C.SilentAim then
            local sp, on = Camera:WorldToViewportPoint(t.Position)
            if on then
                local c = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
                if (Vector2.new(sp.X, sp.Y) - c).Magnitude < C.FOV * 0.75 then
                    getgenv().VantaAimAt(t, false)
                end
            end
        end
        if C.AutoShoot then
            pcall(function()
                local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
                if tool then tool:Activate() end
            end)
        end
    end

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        if C.WalkSpeed then hum.WalkSpeed = C.WalkSpeedVal end
        if C.JumpPower then hum.JumpPower = C.JumpPowerVal end
        if C.NoFallDamage then hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false) end
    end
    if C.Noclip and char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end
    if C.Float and char and char:FindFirstChild("HumanoidRootPart") then
        local v = char.HumanoidRootPart.AssemblyLinearVelocity
        char.HumanoidRootPart.AssemblyLinearVelocity = Vector3.new(v.X, 0.5, v.Z)
    end
end)

