--================ CORE =================--
local function alive(plr)
    local c = plr.Character
    if not c then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    local r = c:FindFirstChild("HumanoidRootPart")
    return h and h.Health > 0 and r
end

local function enemy(plr)
    if plr == LocalPlayer or not alive(plr) then return false end
    if C.TeamCheck and plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then return false end
    return true
end

local function getPart(char)
    return char:FindFirstChild(C.AimPart) or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
end

local function pickTarget()
    local best, bestScore = nil, C.FOV
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    for _, plr in ipairs(Players:GetPlayers()) do
        if not enemy(plr) then continue end
        local part = getPart(plr.Character)
        if not part then continue end
        if root and (part.Position - root.Position).Magnitude > C.MaxDist then continue end
        local sp, on = Camera:WorldToViewportPoint(part.Position)
        if not on then continue end
        local m = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if m < bestScore then bestScore = m; best = part end
    end
    return best
end

local function aimAt(part, hard)
    if not part then return end
    local vel = part.AssemblyLinearVelocity or Vector3.zero
    local pos = part.Position + vel * C.Prediction
    local cf = Camera.CFrame
    Camera.CFrame = cf:Lerp(CFrame.lookAt(cf.Position, pos), hard and 1 or (1 - C.Smooth))
end

-- ESP
local function wipe(plr)
    if drawings[plr] then
        for _, d in pairs(drawings[plr]) do pcall(function() d:Remove() end) end
        drawings[plr] = nil
    end
end

local function ensure(plr)
    if drawings[plr] or not Drawing then return end
    local box = Drawing.new("Square"); box.Thickness=1.3; box.Filled=false; box.Color=Theme.accent; box.Visible=false
    local name = Drawing.new("Text"); name.Size=13; name.Center=true; name.Outline=true; name.Color=Theme.text; name.Visible=false
    local dist = Drawing.new("Text"); dist.Size=11; dist.Center=true; dist.Outline=true; dist.Color=Theme.muted; dist.Visible=false
    local hp = Drawing.new("Text"); hp.Size=11; hp.Center=true; hp.Outline=true; hp.Color=Color3.fromRGB(120,255,160); hp.Visible=false
    local tr = Drawing.new("Line"); tr.Thickness=1.1; tr.Color=Theme.accent; tr.Visible=false
    drawings[plr] = {box=box, name=name, dist=dist, hp=hp, tr=tr}
end

local function updateESP()
    if not C.ESP then for p in pairs(drawings) do wipe(p) end return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if not enemy(plr) then wipe(plr) continue end
        local char = plr.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")
        if not (hum and root and head) then wipe(plr) continue end
        ensure(plr)
        local d = drawings[plr]; if not d then continue end
        local pos, on = Camera:WorldToViewportPoint(root.Position)
        if not on then
            d.box.Visible=false; d.name.Visible=false; d.dist.Visible=false; d.hp.Visible=false; d.tr.Visible=false
            continue
        end
        local top = Camera:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
        local bot = Camera:WorldToViewportPoint(root.Position - Vector3.new(0,3,0))
        local h = math.abs(top.Y - bot.Y)
        local w = h * 0.55
        if C.Boxes then
            d.box.Size = Vector2.new(w,h)
            d.box.Position = Vector2.new(pos.X - w/2, top.Y)
            d.box.Visible = true
        else d.box.Visible = false end
        if C.Names then
            d.name.Text = plr.Name
            d.name.Position = Vector2.new(pos.X, top.Y - 14)
            d.name.Visible = true
        else d.name.Visible = false end
        if C.Distance then
            d.dist.Text = math.floor((root.Position - Camera.CFrame.Position).Magnitude).."m"
            d.dist.Position = Vector2.new(pos.X, bot.Y + 2)
            d.dist.Visible = true
        else d.dist.Visible = false end
        if C.HealthBars then
            d.hp.Text = math.floor(hum.Health).." hp"
            d.hp.Position = Vector2.new(pos.X, bot.Y + 14)
            d.hp.Visible = true
        else d.hp.Visible = false end
        if C.Tracers then
            d.tr.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
            d.tr.To = Vector2.new(pos.X, bot.Y)
            d.tr.Visible = true
        else d.tr.Visible = false end
    end
end
